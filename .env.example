# M2-Tools Server Configuration
PORT=3001

# Database Type: "sqlite" (default) or "mysql" / "mariadb"
DB_TYPE=sqlite

# SQLite Settings (only used when DB_TYPE=sqlite)
# SQLITE_PATH=./data/m2tools.db

# MySQL/MariaDB Settings (only used when DB_TYPE=mysql)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Path to your cube.txt
CUBE_PATH=./public/basic/cube.txt

# JWT Secret for authentication - generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, a random secret is generated per process start (all
# sessions are invalidated on every restart until this is set).
JWT_SECRET=

# Encryption key for stored remote-server credentials (SSH passwords/keys,
# remote-DB passwords in the "Server-Verbindung" feature) - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unlike JWT_SECRET this has NO random fallback: if you already have saved
# connections, losing this key makes their stored credentials permanently
# undecryptable, and the server refuses to start without it in that case.
CREDENTIALS_ENCRYPTION_KEY=

# CORS: comma-separated list of allowed frontend origins in production.
# Leave unset for local development (allows any origin).
# ALLOWED_ORIGINS=https://your-domain.com

# External URL (for email verification links)
# BASE_URL=https://your-domain.com

# SMTP Settings for email verification
# If not configured, registration auto-verifies (development mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=M2-Tools
# SMTP_FROM=noreply@your-domain.com
