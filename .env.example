# M2-Tools Server Configuration
PORT=3001

# Database Type: "sqlite" (default) or "mysql" / "mariadb"
DB_TYPE=sqlite

# SQLite Settings (only used when DB_TYPE=sqlite)
# SQLITE_PATH=./data/m2tools.db

# MySQL/MariaDB Settings (only used when DB_TYPE=mysql)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Optional external icon directory (falls back to public/assets/items/ if unset)
# ICONS_PATH=

# JWT Secret for authentication and the credentials encryption key (below)
# are both OPTIONAL here: if left unset, the in-app setup wizard (open the
# app in a browser for the first time) generates and persists both for you
# into data/runtime-config.json - no manual step needed. Only set these
# yourself if you'd rather manage secrets by hand; doing so skips the
# wizard entirely. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # CREDENTIALS_ENCRYPTION_KEY
# If JWT_SECRET is left unset (and the wizard hasn't run, e.g. no browser
# access to this instance yet), a random secret is generated per process
# start instead (sessions invalidate on every restart until it's set).
JWT_SECRET=

# Unlike JWT_SECRET, CREDENTIALS_ENCRYPTION_KEY has NO random fallback: if
# you already have saved Server-Verbindung connections, losing this key
# makes their stored credentials permanently undecryptable, and the server
# refuses to start without it in that case.
CREDENTIALS_ENCRYPTION_KEY=

# CORS: comma-separated list of allowed frontend origins in production.
# Leave unset for local development (allows any origin).
# ALLOWED_ORIGINS=https://your-domain.com

# External URL (for email verification links)
# BASE_URL=https://your-domain.com

# SMTP Settings for email verification
# If not configured, registration auto-verifies (development mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=M2-Tools
# SMTP_FROM=noreply@your-domain.com
